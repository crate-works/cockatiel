{
  "name": "cockatiel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "routes:generate": "tsr generate",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "build:deploy": "bash scripts/build-deploy.sh",
    "preview": "vite preview",
    "lint:biome": "biome check .",
    "lint:knip": "knip",
    "lint:types": "tsc -b",
    "lint:wasm-version": "bash scripts/check-wasm-vad-version.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ui:coverage": "vitest --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "download:wasm": "bash scripts/download-wasm-vad.sh",
    "copy:coi-sw": "cp node_modules/coi-serviceworker/coi-serviceworker.js public/coi-serviceworker.js",
    "postinstall": "pnpm run copy:coi-sw"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coi-serviceworker": "^0.1.7",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.71.0",
    "oauth4webapi": "^3.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^15.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^7.12.12",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "knip": "^6.45.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-csp-guard": "^4.0.1",
    "vitest": "^4.1.12"
  }
}
