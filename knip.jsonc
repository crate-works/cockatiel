{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignore": [
    // shadcn/ui component library
    "src/components/ui/**",
    // Referenced only via Astro MDX `layout:` frontmatter (a string path), which
    // knip doesn't trace, so it's reported as unused.
    "website/src/layouts/DocsLayout.astro"
  ],
  "ignoreDependencies": [
    // Copied to public/ via the `copy:coi-sw` script; knip can't see it through `cp`.
    "coi-serviceworker"
  ],
  "commitlint": {
    "entry": ["commitlint.config.ts"]
  }
}
